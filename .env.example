# Copy to .env (never commit .env). All values are optional for local development.
DATABASE_URL=sqlite:///./eventsphere.db
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
APP_TIMEZONE=Asia/Colombo
WAITLIST_HOLD_MINUTES=10
SWEEP_INTERVAL_SECONDS=30
CHECKIN_OPENS_MINUTES=180
ENABLE_SCHEDULER=1
SEED_DEMO_DATA=1
DEMO_ADMIN_EMAIL=admin@eventsphere.lk
DEMO_ADMIN_PASSWORD=Admin@2026
DEMO_STAFF_EMAIL=staff@eventsphere.lk
DEMO_STAFF_PASSWORD=Staff@2026
DEMO_ATTENDEE_EMAIL=attendee@eventsphere.lk
DEMO_ATTENDEE_PASSWORD=Attendee@2026
